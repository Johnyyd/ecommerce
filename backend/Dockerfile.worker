FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN addgroup --system appgroup && adduser --system --group appuser

WORKDIR /app

COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

# Copy the actual code
COPY . /app

# Ensure writable directories for appuser
RUN mkdir -p /app/media /app/reports && chown -R appuser:appgroup /app/media /app/reports

# Health check for worker
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import redis; r = redis.from_url('redis://redis:6379'); r.ping()" || exit 1

USER appuser

# Worker runs ARQ worker
CMD ["python", "-m", "app.worker"]
